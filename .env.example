# Chemins du projet & stockage (laisser vide pour utiliser les valeurs par défaut)
PROJECT_ROOT=
DATA_DIR=
DEMO_DIR=
CHROMA_PERSIST_PATH=
CHROMA_COLLECTION_NAME=documents

# Serveur Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_URL=
OLLAMA_LLM_URL=
OLLAMA_TIMEOUT=300.0

# Modèles d'Intelligence Artificielle
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIM=768
LLM_MODEL=gemma2:2b
VLM_MODEL=qwen3-vl

# Paramètres de recherche
TOP_K=5
SIMILARITY_THRESHOLD=1.2

# Paramètres de découpage (chunking) & formats
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SUPPORTED_FORMATS=[".txt", ".nb", ".md", ".pdf", ".docx", ".csv", ".xml", ".xlsx"]